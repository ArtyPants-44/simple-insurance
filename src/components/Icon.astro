---
/**
 * Icon set.
 *
 * Two families here:
 *  - Supplied icons (Who We Help tiles, Why We Are Different chips) live in
 *    src/data/supplied-icons.js. They're solid filled shapes on a 32px box,
 *    so the `stroke` prop doesn't apply to them.
 *  - UI icons below are stroked, drawn in a 40px box, except the arrow which
 *    is the supplied 24px export.
 */
import { suppliedIcons } from "../data/supplied-icons.js";

interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: number;
}
const { name, size = 40, class: className = "", stroke = 2 } = Astro.props;

const supplied = suppliedIcons[name];

/* Most icons are drawn in a 40px box. The arrow is Marty's export:
   16px glyph inside a 24px frame, 2px stroke. Rendering it at 24 gives
   the stroke weight exactly as authored.

   "arrow-up-right-bare" is the same path with the viewBox cropped to the
   glyph's stroke bounds, so at display sizes the number you pass is the
   arrow you see rather than half of it. Used for the large hero arrow. */
const VIEWBOX: Record<string, string> = {
  "arrow-up-right": "0 0 24 24",
  "arrow-up-right-bare": "6.548 6.193 12.258 12.258",
};
const viewBox = supplied ? supplied.viewBox : (VIEWBOX[name] ?? "0 0 40 40");

const line = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": stroke,
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
};
---

<svg
  width={size}
  height={size}
  viewBox={viewBox}
  class={className || undefined}
  role="presentation"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  {supplied && <g fill="currentColor" set:html={supplied.shapes} />}

  {name === "briefcase" && (
    <g {...line}>
      <rect x="4" y="12.5" width="32" height="21" rx="4.5" />
      <path d="M15 12.5V9.5a3.5 3.5 0 0 1 3.5-3.5h3a3.5 3.5 0 0 1 3.5 3.5v3" />
      <path d="M4 20.5c4.6 2.2 10 3.3 16 3.3s11.4-1.1 16-3.3" />
      <path d="M18.4 23.4h3.2" />
    </g>
  )}






  {/* --- UI --- */}
  {/* Exported from Figma. Stroke weight is baked in at 1.93548 so it
      renders exactly as drawn at 24px; `stroke` prop is ignored here.
      Fill changed to currentColor and Figma's clip paths stripped —
      the glyph sits well inside the frame, so they did nothing. */}
  {(name === "arrow-up-right" || name === "arrow-up-right-bare") && (
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="1.93548"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M7.51562 17.4837L17.8382 7.16113M17.8382 14.9031V7.16113H10.0963" />
    </g>
  )}

  {name === "check" && (
    <g {...line}>
      <path d="m10 20.5 7 7 13-14" />
    </g>
  )}

  {name === "close" && (
    <g {...line}>
      <path d="M11 11 29 29M29 11 11 29" />
    </g>
  )}

  {name === "menu" && (
    <g {...line}>
      <path d="M7 14h26M7 26h26" />
    </g>
  )}

  {name === "phone" && (
    <g {...line}>
      <path d="M13.6 7.5h-3A3.5 3.5 0 0 0 7 11.3C7.9 22.6 17.4 32.1 28.7 33a3.5 3.5 0 0 0 3.8-3.5v-3a2 2 0 0 0-1.6-2l-4.6-1a2 2 0 0 0-2.1.9l-1.3 2a17.4 17.4 0 0 1-8.2-8.2l2-1.3a2 2 0 0 0 .9-2.1l-1-4.6a2 2 0 0 0-2-1.6Z" />
    </g>
  )}
</svg>
