---
import Cta from "./Cta.astro";
import Brand from "./Brand.astro";

const base = import.meta.env.BASE_URL;

/* Step 1 copy is taken verbatim from the live site. Steps 2 and 3 are only
   rendered on the live site once the stepper is advanced, so they didn't come
   through in the scrape — the copy below is written to match the voice.
   >>> CONFIRM OR REPLACE steps 2 and 3 with the real copy. <<<

   All three steps currently point at the same photo (the step 01 shot) as a
   placeholder. The alt text below describes the intended final image for each
   step, so it will only be accurate for 02 and 03 once those are generated.
   >>> REPLACE how-legwork.jpg and how-covered.jpg. <<< */
const steps = [
  {
    n: "01",
    title: "Tell us about your business.",
    body: "Give us the details of your business and what you need covered. We'll ask what's relevant to you — nothing more, nothing less — so the cover we find actually fits.",
    image: `${base}images/how-consult.jpg`,
    alt: "Broker walking a business owner through her cover options",
  },
  {
    n: "02",
    title: "We do the legwork.",
    body: "We take your details to the market and compare cover across the insurers and underwriters we access — then come back with options in plain language, not a stack of PDFs.",
    image: `${base}images/how-legwork.jpg`,
    alt: "Broker comparing policy options",
  },
  {
    n: "03",
    title: "You're covered.",
    body: "Once you're happy, we put the cover in place and send you a summary you can actually read. Same people every time — including at claim time.",
    image: `${base}images/how-covered.jpg`,
    alt: "Business owner back at work, covered",
  },
];
---

{/* Default layout is a plain stacked list — that is what no-JS, small screens
    and reduced-motion users get. The pinned scroll carousel is layered on by
    motion.js, which adds .is-pinned once it knows there is room for it. */}
<section class="hiw" id="how-it-works" data-stepper>
  <div class="container hiw__head">
    <p class="eyebrow hiw__eyebrow" data-reveal style="--i:0">
      How It Works
      <Brand variant="quarter-dot" height={26} />
    </p>

    <h2 class="h2 hiw__title" data-reveal style="--i:1">
      <span>Getting covered.</span> <em>Made Simple.</em>
    </h2>
  </div>

  <div class="hiw__track" data-step-track>
    <div class="hiw__stage">
      <div class="container hiw__frame" data-step-frame>
        {steps.map((s) => (
          <div class="hiw__slide" data-step-slide>
            <figure class="hiw__card" data-step-card>
              <img
                src={s.image}
                alt={s.alt}
                width="724" height="1000"
                loading="lazy" decoding="async"
              />
            </figure>

            <div class="hiw__copy" data-step-copy>
              <p class="hiw__num">{s.n}</p>
              <h3 class="h4 hiw__slide-title">{s.title}</h3>
              <p class="hiw__slide-body">{s.body}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="container hiw__rail">
        <span class="hiw__rail-label">How It Works</span>
        {steps.map((s) => (
          <button
            class="hiw__dot"
            data-step-trigger
            type="button"
            aria-label={`Step ${s.n} — ${s.title}`}
          >
            {s.n}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="container hiw__cta" data-reveal>
    <Cta label="Get Started" href="#contact" />
  </div>
</section>

<style>
  .hiw {
    background: var(--c-neutral-100);
    color: var(--c-primary-900);
    position: relative;
  }

  .hiw__head { text-align: center; padding-top: clamp(72px, 9vw, 140px); }
  .hiw__eyebrow { color: var(--c-primary-900); }
  .hiw__title { margin-top: 26px; color: var(--c-primary-700); }
  .hiw__title em { font-style: normal; color: var(--c-primary-500); }

  /* ---- Stacked default (no-JS, small screens, reduced motion) ---- */
  .hiw__frame {
    display: grid;
    gap: clamp(48px, 7vw, 80px);
    margin-top: clamp(40px, 6vw, 72px);
  }

  .hiw__slide {
    display: grid;
    justify-items: center;
    gap: 28px;
    text-align: center;
  }

  .hiw__card {
    margin: 0;
    width: min(100%, 362px);
    aspect-ratio: 362 / 500;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--c-neutral-300);
  }
  .hiw__card img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .hiw__copy { max-width: 34ch; }
  .hiw__num {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-primary-500);
  }
  .hiw__slide-title { margin-top: 10px; color: var(--c-primary-700); }
  .hiw__slide-body { margin-top: 12px; color: var(--c-neutral-900); }

  .hiw__rail { display: none; }
  .hiw__rail-label {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-neutral-500);
    margin-right: 8px;
  }

  .hiw__cta {
    display: flex;
    justify-content: center;
    padding-bottom: clamp(72px, 9vw, 140px);
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* ============================================================
     Pinned conveyor (motion.js adds .is-pinned)

     Three stations: bottom-right (next, small) -> centre (current,
     large) -> top-left (previous, small). Each card travels the whole
     path as you scroll; motion.js writes the transforms, so nothing
     here positions them beyond the shared centre origin.
     ============================================================ */
  .hiw.is-pinned .hiw__track { height: calc(var(--hiw-steps, 3) * 100svh); }

  .hiw.is-pinned .hiw__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    /* top pad clears the floating nav pill */
    padding-block: clamp(96px, 13vh, 132px) clamp(28px, 5vh, 56px);
  }

  .hiw.is-pinned .hiw__frame {
    position: relative;
    display: block;
    margin-top: 0;
    min-height: 0;
  }

  /* The wrapper stops laying anything out — card and copy position
     against the frame instead, so each can move on its own. */
  .hiw.is-pinned .hiw__slide { display: contents; }

  .hiw.is-pinned .hiw__card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    height: min(100%, clamp(300px, 66svh, 620px));
    aspect-ratio: 362 / 500;
    transform: translate(-50%, -50%);
    transform-origin: 50% 50%;
    will-change: transform, opacity;
    box-shadow: 0 18px 50px -28px rgba(8, 18, 11, 0.45);
  }

  .hiw.is-pinned .hiw__copy {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(30ch, 33%);
    max-width: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }

  /* Step rail, bottom-left */
  .hiw.is-pinned .hiw__rail {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .hiw__dot {
    position: relative;
    padding: 8px 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--c-neutral-500);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hiw__dot:hover { color: var(--c-primary-600); }
  .hiw__dot.is-active { color: var(--c-primary-900); }
  .hiw__dot::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: var(--c-primary-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out);
  }
  .hiw__dot.is-active::after { transform: scaleX(1); }

  .hiw.is-pinned .hiw__cta { margin-top: 0; }

  /* Stacked mode gets a gentle scale-up as each card nears the middle of the
     viewport. It is scroll-linked, so no transition — that would lag behind
     the scroll rather than track it. */
  .hiw:not(.is-pinned) .hiw__card { will-change: transform; }
</style>
