---
import Cta from "./Cta.astro";
import Icon from "./Icon.astro";

/* Drop the hero video at /public/images/hero.mp4 and it will be used
   automatically; hero.jpg is the poster + no-JS/reduced-motion fallback. */
const useVideo = true;
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top">
  <div class="hero__media">
    {useVideo ? (
      <video
        class="hero__video"
        data-hero-video
        autoplay muted loop playsinline
        preload="metadata"
        poster={`${base}images/hero.jpg`}
        aria-hidden="true"
      >
        <source src={`${base}images/hero.mp4`} type="video/mp4" />
      </video>
    ) : (
      <img class="hero__img" src={`${base}images/hero.jpg`} alt="" />
    )}
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__inner">
    <p class="hero__kicker" data-reveal style="--i:0">
      Business insurance, minus the run-around
    </p>

    <h1 class="display hero__title" data-reveal style="--i:1">
      The <em>Simple</em> way to<br />
      <u>cover</u> your business.
    </h1>

    <p class="hero__lede body-lg" data-reveal style="--i:2">
      The cover you need, minus the jargon and the run-around.
      <strong>Simple to deal with</strong> — serious about protecting you.
    </p>

    <div class="hero__actions" data-reveal style="--i:3">
      <!-- Large brand arrow, cropped viewBox so size = visible size.
           Anchored to the button row so it always points at the CTA. -->
      <div class="hero__arrow" data-cursor-parallax="40" aria-hidden="true">
        <Icon name="arrow-up-right-bare" size={120} />
      </div>

      <Cta label="Get Started" href="#contact" />
      <a href="#how-it-works" class="glass-link">
        See how it works
        <Icon name="arrow-up-right" size={24} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    color: var(--c-white);
  }

  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__video,
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* image itself drifts a little slower than the page */
    transform: scale(1.06);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8,18,11,0.55) 0%, rgba(8,18,11,0.28) 42%, rgba(8,18,11,0.62) 100%),
      radial-gradient(70% 55% at 50% 45%, rgba(8,18,11,0.15) 0%, rgba(8,18,11,0.6) 100%);
  }

  .hero__inner {
    position: relative;
    text-align: center;
    padding-block: 160px 96px;
  }

  .hero__kicker {
    font-family: var(--font-primary);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-primary-300);
    margin-bottom: 22px;
  }

  .hero__title { max-width: 15ch; margin-inline: auto; }
  .hero__title em { font-style: normal; color: var(--c-primary-500); }
  .hero__title u {
    text-decoration: none;
    box-shadow: inset 0 -0.09em 0 0 currentColor;
  }

  .hero__lede {
    max-width: 46ch;
    margin: 26px auto 0;
    color: rgba(255, 255, 255, 0.9);
  }
  .hero__lede strong { color: var(--c-white); font-weight: 700; }

  /* Shrink-wraps the buttons so .hero__arrow's `right: 100%` anchors to
     the button row itself rather than the full container width. */
  .hero__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    width: fit-content;
    max-width: 100%;
    margin: 40px auto 0;
  }

  .hero__arrow {
    position: absolute;
    right: 100%;
    bottom: -38px;
    margin-right: clamp(24px, 4.5vw, 72px);
    width: clamp(78px, 9.5vw, 120px);
    color: var(--c-primary-500);
    will-change: transform;
    pointer-events: none;
  }
  .hero__arrow :global(svg) { width: 100%; height: auto; }

  @media (max-width: 900px) {
    .hero__inner { padding-block: 140px 80px; }
  }

  /* No room beside a centred, wrapping button row on narrow screens. */
  @media (max-width: 860px) {
    .hero__arrow { display: none; }
  }
</style>
