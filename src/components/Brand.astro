---
/**
 * Brand marks.
 *
 * Symbol + wordmark are the real outlined paths from logo-2-colour.svg
 * (852x120). Type is outlined, so there's no font dependency.
 *
 * Inlined rather than <img> so the wordmark and symbol can be recoloured
 * per surface without shipping a separate file for every combination.
 *
 * variant:
 *   "logo"          - symbol + wordmark lockup
 *   "symbol"        - symbol as authored (green tile, dark S, white dot)
 *   "symbol-invert" - white tile, green S, dark dot (for dark surfaces)
 *   "leaves"        - twin leaf mark beside OUR PROMISE / WHO WE HELP
 *   "quarter-dot"   - quarter disc + dot beside HOW IT WORKS / WHY WE ARE DIFFERENT
 *
 * tone: "dark" (default) renders "insurance" in primary-900;
 *       "light" renders it white for dark backgrounds.
 */
interface Props {
  variant?: "logo" | "symbol" | "symbol-invert" | "leaves" | "quarter-dot";
  tone?: "light" | "dark";
  height?: number;
  class?: string;
}
const {
  variant = "logo",
  tone = "dark",
  height = 36,
  class: className = "",
} = Astro.props;

const GREEN = "#59BF7A";
const DARK = "#102317";

const c = variant === "symbol-invert"
  ? { tile: "#FFFFFF", mark: GREEN, dot: DARK }
  : { tile: GREEN, mark: DARK, dot: "#FFFFFF" };

const wordInsurance = tone === "light" ? "#FFFFFF" : DARK;
