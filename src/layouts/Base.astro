---
import "../styles/global.css";

interface Props { title?: string; description?: string; }
const {
  title = "Simple Insurance — The simple way to cover your business",
  description = "Business insurance, minus the run-around. The cover you need without the jargon — simple to deal with, serious about protecting you.",
} = Astro.props;

/* Set PUBLIC_NOINDEX="true" on any preview/staging deploy. The client's real
   site is live on this same copy, so an indexable preview would compete with
   it in search. Leave unset in production. */
const noindex = import.meta.env.PUBLIC_NOINDEX === "true";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href="https://simpleinsurance.com.au/" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-card.jpg" />

    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />

    <!-- Manrope 800 for headings, Inter for body — per the Figma type spec -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script src="../scripts/motion.js"></script>
  </body>
</html>
